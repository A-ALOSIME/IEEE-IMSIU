---
const {kind,target,fields=[],siteKey=''}=Astro.props;
const inputType=(type:string):'email'|'tel'|'number'|'date'|'file'|'text'=>['email','tel','number','date','file'].includes(type)?type as 'email'|'tel'|'number'|'date'|'file':'text';
---
<form class="dynamic-form" data-public-form data-kind={kind} data-target={target} enctype="multipart/form-data">
 {fields.map((field:any,index:number)=><label class="form-field"><span>{field.label}{field.required&&<em> *</em>}</span>{field.help&&<small>{field.help}</small>}{field.type==='textarea'?<textarea name={String(index)} required={field.required} maxlength="2000"></textarea>:field.type==='select'?<select name={String(index)} required={field.required}><option value="">اختر</option>{String(field.options||'').split(/،|,/).filter(Boolean).map((option:string)=><option>{option.trim()}</option>)}</select>:field.type==='checkbox'?<input name={String(index)} type="checkbox" value="نعم" required={field.required}/>:<input name={String(index)} type={inputType(field.type)} required={field.required} accept={field.type==='file'?'.pdf,image/png,image/jpeg,image/webp':undefined} maxlength={field.type==='file'?undefined:'2000'}/>}</label>)}
 {siteKey&&<div class="cf-turnstile" data-sitekey={siteKey}></div>}
 <button class="button primary" type="submit">إرسال الطلب</button><p class="form-result" role="status" aria-live="polite"></p>
</form>
{siteKey&&<script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>}
