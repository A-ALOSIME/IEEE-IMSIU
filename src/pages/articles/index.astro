---
import BaseLayout from '../../layouts/BaseLayout.astro';import {articleImage,publicState,published} from '../../lib/public-data';const articles=published((await publicState()).articles);
---
<BaseLayout title="المقالات | IEEE IMSIU"><section class="page-hero"><div class="container"><div class="breadcrumbs"><a href="/" data-en="Home">الرئيسية</a> / <span data-en="Articles">المقالات</span></div><h1 data-en="Ideas worth sharing.">أفكار تستحق<br/>أن تُشارك.</h1><p data-en="Technical knowledge and student experiences written from within our community.">معرفة تقنية وتجارب طلابية نكتبها من قلب المجتمع.</p></div></section><section class="section soft"><div class="container">{articles.length?<div class="grid">{articles.map(article=><a class="card" href={`/articles/${article.slug}`}><div class="card-media"><img src={articleImage(article)} alt={String(article.alt||article.title)}></div><div class="card-body"><span class="pill">{String(article.category)}</span><h2 data-en={String(article.titleEn||article.title)}>{String(article.title)}</h2><p>{String(article.excerpt||'')}</p></div></a>)}</div>:<div class="empty"><h2 data-en="No published articles right now.">لا توجد مقالات منشورة الآن.</h2><p data-en="New writing will appear here when it is published.">ستظهر هنا الكتابات الجديدة عند نشرها.</p></div>}</div></section></BaseLayout>
