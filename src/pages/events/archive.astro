---
import BaseLayout from '../../layouts/BaseLayout.astro';
import {archiveEvents,archiveImage} from '../../lib/archive';
const groups=[...new Set(archiveEvents.map(event=>event.year))].sort((a,b)=>Number(a)-Number(b));
const categoryEn:Record<string,string>={لقاء:'Talk',ورشة:'Workshop',معسكر:'Camp',دورة:'Course',منافسة:'Competition',تعاون:'Collaboration',مشاركة:'Participation',زيارة:'Visit'};
---
<BaseLayout title="سجل الفعاليات | IEEE IMSIU"><section class="page-hero"><div class="container"><div class="breadcrumbs"><a href="/" data-en="Home">الرئيسية</a> / <a href="/events" data-en="Events">الفعاليات</a> / <span data-en="Archive">السجل</span></div><div class="section-heading"><div><h1 data-en="Our experiences, as we lived them.">تجاربنا،<br/>كما عشناها.</h1><p data-en="Workshops and camps, talks and challenges. The stories stay here, ready for you to explore.">ورش ومعسكرات، لقاءات وتحدّيات. هنا تبقى الحكاية، وتبدأ رحلتك في استكشافها.</p></div><strong dir="ltr">2020—2026</strong></div><nav class="tabs-line" aria-label="صفحات الفعاليات"><a href="/events" data-en="Current events">الفعاليات الحالية</a><a class="active" href="/events/archive" data-en="Events archive">سجل الفعاليات</a></nav></div></section><section class="section soft"><div class="container"><div class="archive-toolbar"><p data-en={`${archiveEvents.length} documented experiences`}>{archiveEvents.length} تجربة في السجل</p><a class="text-link" href="/events" data-en="Current events">الفعاليات الحالية ←</a></div>{groups.map(group=><section class="archive-year"><h2 dir="ltr">{group}</h2><div class="archive-cards">{archiveEvents.filter(event=>event.year===group).map(event=><a class="archive-card" href={`/events/${event.id}`}><img src={archiveImage(event)} alt={event.title} loading="lazy"><div><small data-en={categoryEn[event.category]}>{event.category}</small><h3 data-en={event.titleEn}>{event.title}</h3><p>{event.summary}</p>{event.speaker&&<span class="presenter"><b data-en="Presented by">تقديم</b> {event.speaker}</span>}<div class="archive-card-bottom"><time>{event.date}</time><span aria-hidden="true">←</span></div></div></a>)}</div></section>)}</div></section></BaseLayout>
