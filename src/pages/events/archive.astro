---
import BaseLayout from '../../layouts/BaseLayout.astro';
import {archiveEvents} from '../../lib/archive';
const years=[...new Set(archiveEvents.map(event=>event.year))].sort((a,b)=>Number(b)-Number(a));
const categoryEn:Record<string,string>={لقاء:'Talk',ورشة:'Workshop',معسكر:'Camp',دورة:'Course',مسابقة:'Competition',تعاون:'Collaboration'};
---
<BaseLayout title="سجل الفعاليات | IEEE IMSIU"><section class="page-hero"><div class="container"><div class="breadcrumbs"><a href="/" data-en="Home">الرئيسية</a> / <a href="/events" data-en="Events">الفعاليات</a> / <span data-en="Archive">السجل</span></div><div class="section-heading"><div><h1 data-en="The events archive.">سجل الفعاليات.</h1><p data-en="A record of the workshops, camps, talks, and collaborations that shaped the club’s journey.">سجل للورش والمعسكرات واللقاءات والتعاونات التي صنعت رحلة النادي.</p></div><strong dir="ltr">2021—2025</strong></div><nav class="tabs-line" aria-label="صفحات الفعاليات"><a href="/events" data-en="Current events">الفعاليات الحالية</a><a class="active" href="/events/archive" data-en="Events archive">سجل الفعاليات</a></nav></div></section><section class="section soft"><div class="container"><div class="archive-toolbar"><p data-en={`${archiveEvents.length} documented experiences`}>{archiveEvents.length} تجربة موثقة</p><a class="text-link" href="/events" data-en="Current events">الفعاليات الحالية ←</a></div>{years.map(year=><section class="archive-year"><h2 dir="ltr">{year}</h2><div class="archive-cards">{archiveEvents.filter(event=>event.year===year).map(event=><article class="archive-card"><img src={`/admin/assets/events/${event.image}`} alt={event.title} loading="lazy"><div><small data-en={categoryEn[event.category]}>{event.category}</small><h3 data-en={event.titleEn}>{event.title}</h3></div></article>)}</div></section>)}</div></section></BaseLayout>
