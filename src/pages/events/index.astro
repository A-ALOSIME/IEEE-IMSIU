---
import BaseLayout from '../../layouts/BaseLayout.astro';import {eventImage,publicState,published} from '../../lib/public-data';const events=published((await publicState()).events);
---
<BaseLayout title="الفعاليات | IEEE IMSIU"><section class="section"><div class="container"><div class="section-heading"><div><p class="eyebrow">تجارب عملية</p><h1>الفعاليات</h1><p>ورش، لقاءات، ومعسكرات يقودها مجتمعنا.</p></div></div>{events.length?<div class="grid">{events.map(event=><a class="card" href={`/events/${event.id}`}><div class="card-media"><img src={eventImage(event)} alt={String(event.alt||event.title)}></div><div class="card-body"><span class="pill">{event.registration==='open'?'التسجيل مفتوح':'عرض التفاصيل'}</span><h2>{String(event.title)}</h2><div class="meta"><span>{String(event.date)} · {String(event.time)}</span><span>{String(event.location||'')}</span></div></div></a>)}</div>:<div class="empty"><h2>لا توجد فعاليات منشورة الآن</h2><p>عد قريبًا للاطلاع على برامجنا القادمة.</p></div>}</div></section></BaseLayout>
