---
import BaseLayout from '../../layouts/BaseLayout.astro';
import {eventImage,publicState,published} from '../../lib/public-data';
import {formatDate,formatTime} from '../../lib/format';
const events=published((await publicState()).events);
const registrationLabel=(value:unknown)=>value==='open'?'التسجيل مفتوح':value==='waitlist'?'قائمة الانتظار':value==='soon'?'قريبًا':'التفاصيل';
const registrationLabelEn=(value:unknown)=>value==='open'?'Registration open':value==='waitlist'?'Waitlist':value==='soon'?'Coming soon':'Details';
---
<BaseLayout title="الفعاليات | IEEE IMSIU"><section class="page-hero"><div class="container"><div class="breadcrumbs"><a href="/" data-en="Home">الرئيسية</a> / <span data-en="Events">الفعاليات</span></div><div class="section-heading"><div><h1 data-en="Experiences worth joining.">تجارب تستحق<br/>أن تكون جزءًا منها.</h1><p data-en="Workshops, talks, camps, and challenges built for students who want to learn by doing.">ورش ولقاءات ومعسكرات وتحديات صُممت للطلاب الذين يريدون التعلّم بالممارسة.</p></div></div><nav class="tabs-line" aria-label="صفحات الفعاليات"><a class="active" href="/events" data-en="Current events">الفعاليات الحالية</a><a href="/events/archive" data-en="Events archive">سجل الفعاليات</a></nav></div></section><section class="section soft"><div class="container">{events.length?<div class="grid">{events.map(event=><a class="card" href={`/events/${event.id}`}><div class="card-media"><img src={eventImage(event)} alt={String(event.alt||event.title)}></div><div class="card-body"><span class="pill" data-en={registrationLabelEn(event.registration)}>{registrationLabel(event.registration)}</span><h2 data-en={String(event.titleEn||event.title)}>{String(event.title)}</h2><div class="meta"><span>{formatDate(event.date)} · {formatTime(event.time)}</span><span>{String(event.location||'')}</span></div></div></a>)}</div>:<div class="empty"><div class="empty-illustration" aria-hidden="true">▦</div><h2 data-en="No current events right now.">لا توجد فعاليات حالية الآن.</h2><p data-en="Explore the archive to see the workshops, camps, and experiences we have hosted.">تصفّح السجل للتعرّف على الورش والمعسكرات والتجارب التي قدمناها.</p><a class="button primary" href="/events/archive" data-en="Browse the events archive">تصفّح سجل الفعاليات</a></div>}</div></section></BaseLayout>
