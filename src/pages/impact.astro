---
import BaseLayout from '../layouts/BaseLayout.astro';import {publicState} from '../lib/public-data';const state=await publicState();const hours=state.hours.reduce((sum,row)=>sum+Number(row.hours||0),0);
---
<BaseLayout title="أثرنا | IEEE IMSIU"><section class="section"><div class="container"><div class="section-heading"><div><p class="eyebrow">الأثر المنشور</p><h1>الأرقام تحكي جزءًا من القصة</h1><p>مؤشرات مباشرة من أنشطة النادي المعتمدة.</p></div></div><div class="metrics"><div class="metric"><b>{state.events.filter(x=>x.status==='published').length.toLocaleString('en-US')}</b><span>فعالية منشورة</span></div><div class="metric"><b>{state.members.filter(x=>x.status==='active').length.toLocaleString('en-US')}</b><span>عضو نشط</span></div><div class="metric"><b>{hours.toLocaleString('en-US')}</b><span>ساعة تطوعية</span></div><div class="metric"><b>{state.articles.filter(x=>x.status==='published').length.toLocaleString('en-US')}</b><span>مقال معرفي</span></div></div></div></section></BaseLayout>
