---
import BaseLayout from '../layouts/BaseLayout.astro';import {articleImage,eventImage,publicState,published} from '../lib/public-data';
const state=await publicState(),events=published(state.events).slice(0,3),articles=published(state.articles).slice(0,3);
---
<BaseLayout title="IEEE IMSIU | نصنع أثرًا تقنيًا"><section class="hero"><div class="hero-content"><p class="eyebrow">IEEE STUDENT BRANCH · IMSIU</p><h1>مجتمع تقني يصنع أثرًا يتجاوز القاعة</h1><p>نجمع الشغف بالمعرفة والعمل التطوعي لنمنح طلاب الجامعة تجارب أقرب إلى المستقبل.</p><div class="actions"><a class="button primary" href="/events">استكشف الفعاليات</a><a class="button ghost" href="/join">انضم إلى الفريق</a></div></div></section>
{events.length>0&&<section class="section"><div class="container"><div class="section-heading"><div><p class="eyebrow">القادم</p><h2>فعاليات النادي</h2></div><a href="/events">كل الفعاليات ←</a></div><div class="grid">{events.map(event=><a class="card" href={`/events/${event.id}`}><div class="card-media"><img src={eventImage(event)} alt={String(event.alt||event.title)}></div><div class="card-body"><span class="pill">{event.registration==='open'?'التسجيل مفتوح':'التفاصيل'}</span><h3>{String(event.title)}</h3><div class="meta"><span>{String(event.date)}</span><span>{String(event.location||'')}</span></div></div></a>)}</div></div></section>}
<section class="section alt"><div class="container two-col"><div><p class="eyebrow">IEEE IMSIU</p><h2>مساحة للتعلم والتجربة والقيادة</h2><p>نصمم برامج تقنية ومجتمعية يقودها الطلاب، ونحوّل المشاركة إلى خبرة موثقة وساعات تطوعية وأثر يمكن قياسه.</p><a class="button primary" href="/about">تعرف علينا</a></div><img class="feature-image" src="/admin/assets/community.webp" alt="مجتمع IEEE IMSIU"></div></section>
{articles.length>0&&<section class="section"><div class="container"><div class="section-heading"><div><p class="eyebrow">المعرفة</p><h2>أحدث المقالات</h2></div><a href="/articles">كل المقالات ←</a></div><div class="grid">{articles.map(article=><a class="card" href={`/articles/${article.slug}`}><div class="card-media"><img src={articleImage(article)} alt={String(article.alt||article.title)}></div><div class="card-body"><span class="pill">{String(article.category)}</span><h3>{String(article.title)}</h3><p>{String(article.excerpt||'')}</p></div></a>)}</div></div></section>}
<section class="section alt"><div class="container two-col"><div><p class="eyebrow">شاركنا الرحلة</p><h2>مكانك معنا يصنع فرقًا</h2><p>اختر اللجنة الأقرب لك وابدأ تجربة تطوعية عملية داخل مجتمع تقني طموح.</p></div><div class="actions"><a class="button primary" href="/join">قدّم طلب الانضمام</a><a class="button" href="/collaboration">تعاون معنا</a></div></div></section></BaseLayout>
