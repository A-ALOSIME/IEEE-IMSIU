---
import BaseLayout from '../layouts/BaseLayout.astro';
import PartnerLogos from '../components/PartnerLogos.astro';
import {articleImage,eventImage,publicState,published} from '../lib/public-data';
import {formatDate,formatTime} from '../lib/format';
const state=await publicState(),events=published(state.events).slice(0,3),articles=published(state.articles).slice(0,3);
---
<BaseLayout title="IEEE IMSIU | فضولك التقني يستحق التجربة">
 <section class="home-hero"><div class="container">
  <div class="home-intro"><h1 data-en="Your technical curiosity deserves the experience.">فضولك التقني<br/>يستحق التجربة.</h1><p data-en="We are IEEE IMSIU, the IEEE Student Branch at Imam Mohammad Ibn Saud Islamic University. We meet to learn, build, and share our passion for technology.">نحن IEEE IMSIU، الفرع الطلابي لـ IEEE في جامعة الإمام محمد بن سعود الإسلامية. نجتمع لنتعلّم، ونطبّق، ونشارك شغفنا بالتقنية.</p><div class="actions"><a class="button primary" href="/events" data-en="Explore events">اكتشف الفعاليات</a><a class="text-link" href="/about" data-en="About the club">تعرّف على النادي ←</a></div></div>
  <div class="story-grid" aria-label="استكشف تجارب النادي">
   <a class="story-card" href="/events/archive"><img src="/admin/assets/xtreme.webp" alt="تحدي IEEEXtreme"><div class="story-copy"><small data-en="We challenge ourselves">نتحدّى أنفسنا</small><h2 data-en="An idea, a team, and a challenge.">فكرة، فريق، وتحدٍّ.</h2><span>IEEEXtreme</span></div></a>
   <a class="story-card featured" href="/events/archive"><img src="/admin/assets/data.webp" alt="معسكر علم البيانات"><div class="story-copy"><small data-en="We learn by doing">نتعلّم بالممارسة</small><h2 data-en="Knowledge starts it. Experience completes it.">المعرفة تبدأ.<br/>والتجربة تكملها.</h2><span data-en="Data Science Camp">معسكر علم البيانات</span></div></a>
   <a class="story-card" href="/events/archive"><img src="/admin/assets/devfest.webp" alt="مشاركة النادي في DevFest"><div class="story-copy"><small data-en="We share our passion">نشارك شغفنا</small><h2 data-en="Ideas come together.">أفكار تتلاقى.</h2><span data-en="From our community">من مجتمعنا</span></div></a>
  </div>
 </div></section>
 <section class="section"><div class="container editorial-grid"><div class="editorial-title"><h2 data-en="Knowledge grows when we use it.">المعرفة تكبر<br/>حين نستخدمها.</h2><a class="text-link" href="/about" data-en="Our story">هذه حكايتنا ←</a></div><div class="editorial-copy"><p data-en="Our journey started in 2020. Since then, the club has become a space where students move beyond the classroom and turn what they learn into real experience.">بدأت رحلتنا في 2020. ومنذ ذلك الوقت، صار النادي مساحة نلتقي فيها خارج حدود المقرر، ونأخذ ما نتعلّمه إلى تجربة حقيقية.</p><p data-en="A workshop that makes an idea clearer, a camp that builds a skill, and a competition that pushes us forward. This is what brings us together at IEEE IMSIU.">ورشة تقرّب مفهومًا، معسكر نبني فيه مهارة، ومنافسة تدفعنا إلى خطوة أبعد. هذا ما نجتمع عليه في IEEE IMSIU.</p><div class="legacy-metrics"><div class="legacy-metric"><strong dir="ltr" data-count="21" data-suffix="+">21+</strong><span data-en="Workshops">ورشة عمل</span></div><div class="legacy-metric"><strong dir="ltr" data-count="3216" data-suffix="+">3,216+</strong><span data-en="Attendees">حضورًا</span></div></div><a class="text-link" href="/impact" data-en="Impact and achievements">الأثر والإنجازات ←</a></div></div></section>
 {events.length>0&&<section class="section soft"><div class="container"><div class="section-heading"><div><p class="eyebrow" data-en="Coming up">القادم</p><h2 data-en="Club events">فعاليات النادي</h2></div><a class="text-link" href="/events" data-en="All events">كل الفعاليات ←</a></div><div class="grid">{events.map(event=><a class="card" href={`/events/${event.id}`}><div class="card-media"><img src={eventImage(event)} alt={String(event.alt||event.title)}></div><div class="card-body"><span class="pill" data-en={event.registration==='open'?'Registration open':'Details'}>{event.registration==='open'?'التسجيل مفتوح':'التفاصيل'}</span><h3 data-en={String(event.titleEn||event.title)}>{String(event.title)}</h3><div class="meta"><span>{formatDate(event.date)} · {formatTime(event.time)}</span><span>{String(event.location||'')}</span></div></div></a>)}</div></div></section>}
 <section class="section soft"><div class="container feature-split"><div><p class="eyebrow" data-en="From the 2025 archive">من تجارب 2025</p><h2 data-en="Every experience leaves something behind.">كل تجربة<br/>تترك شيئًا.</h2><p data-en="Ideas became projects, conversations opened new paths, and experiences became worth keeping.">أفكار تحوّلت إلى مشاريع، ولقاءات فتحت مسارًا، وتجارب تستحق أن تبقى.</p><a class="button primary" href="/events/archive" data-en="Browse the events archive">تصفّح سجل الفعاليات</a></div><img class="feature-image" src="/admin/assets/ar.webp" alt="مشاريع معسكر الواقع المعزز"></div></section>
 {articles.length>0&&<section class="section"><div class="container"><div class="section-heading"><div><p class="eyebrow" data-en="Knowledge">المعرفة</p><h2 data-en="Latest articles">أحدث المقالات</h2></div><a class="text-link" href="/articles" data-en="All articles">كل المقالات ←</a></div><div class="grid">{articles.map(article=><a class="card" href={`/articles/${article.slug}`}><div class="card-media"><img src={articleImage(article)} alt={String(article.alt||article.title)}></div><div class="card-body"><span class="pill">{String(article.category)}</span><h3 data-en={String(article.titleEn||article.title)}>{String(article.title)}</h3><p>{String(article.excerpt||'')}</p></div></a>)}</div></div></section>}
 <section class="section partner-section"><div class="container"><div class="partner-heading"><h2 data-en="We meet around passion and build impact together.">نتقاطع في الشغف.<br/>ونلتقي على الأثر.</h2><p data-en="Organizations we worked with across the club’s experiences and initiatives.">جهات عملنا معها في تجارب النادي ومبادراته.</p><a class="text-link" href="/collaboration" data-en="Partner with us">تعاون معنا ←</a></div><PartnerLogos/></div></section>
 <section class="section"><div class="container cta-band"><div><p class="eyebrow">IEEE IMSIU</p><h2 data-en="Your place with us makes a difference.">مكانك معنا<br/>يصنع فرقًا.</h2></div><div class="actions"><a class="button primary" href="/join" data-en="Apply to join">قدّم طلب الانضمام</a><a class="button" href="/collaboration" data-en="Partner with us">تعاون معنا</a></div></div></section>
</BaseLayout>
