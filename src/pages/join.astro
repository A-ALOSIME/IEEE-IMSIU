---
import {env} from 'cloudflare:workers';
import BaseLayout from '../layouts/BaseLayout.astro';
import DynamicForm from '../components/DynamicForm.astro';
import {publicState} from '../lib/public-data';
const cycles=(await publicState()).cycles.filter(row=>row.status==='open');
---
<BaseLayout title="انضم إلينا | IEEE IMSIU"><section class="page-hero"><div class="container"><div class="breadcrumbs"><a href="/" data-en="Home">الرئيسية</a> / <span data-en="Join us">انضم إلينا</span></div><h1 data-en="Build your experience with us.">اصنع تجربتك<br/>معنا.</h1><p data-en="Four committees and many ways to learn, contribute, and lead within an ambitious technical community.">أربع لجان، ومساحات متنوعة للتعلم والتطوع والقيادة داخل مجتمع تقني طموح.</p></div></section><section class="section soft"><div class="container"><div class="grid"><div class="card"><div class="card-body"><h2 data-en="Activities Committee">لجنة الأنشطة</h2><p data-en="Design and run events and workshops.">تصميم وتنفيذ الفعاليات والورش.</p></div></div><div class="card"><div class="card-body"><h2 data-en="Media Committee">لجنة الإعلام</h2><p data-en="Coverage, identity, and visual content.">التغطيات والهوية والمحتوى المرئي.</p></div></div><div class="card"><div class="card-body"><h2 data-en="Content and Development Committee">لجنة المحتوى والتطوير</h2><p data-en="Knowledge content and team development.">المحتوى المعرفي وتنمية مهارات الفريق.</p></div></div><div class="card"><div class="card-body"><h2 data-en="Human Resources Committee">لجنة الموارد البشرية</h2><p data-en="Member experience and team organization.">تجربة الأعضاء وتنظيم الفريق.</p></div></div></div></div></section><section class="section"><div class="container">{cycles.map(cycle=><section><div class="section-heading"><div><h2>{String(cycle.title)}</h2><p>{String(cycle.description||'')}</p></div></div><DynamicForm kind="applications" target={cycle.id} fields={cycle.fields} siteKey={env.TURNSTILE_SITE_KEY}/></section>)}{!cycles.length&&<div class="empty"><h2 data-en="Applications are currently closed.">باب الانضمام مغلق حاليًا.</h2><p data-en="We will announce the next membership cycle when it opens.">سنعلن عن دورة القبول القادمة عند فتحها.</p></div>}</div></section></BaseLayout>
