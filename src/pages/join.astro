---
import {env} from 'cloudflare:workers';import BaseLayout from '../layouts/BaseLayout.astro';import DynamicForm from '../components/DynamicForm.astro';import {publicState} from '../lib/public-data';const cycles=(await publicState()).cycles.filter(row=>row.status==='open');
---
<BaseLayout title="انضم إلينا | IEEE IMSIU"><section class="section"><div class="container"><div class="section-heading"><div><p class="eyebrow">عضوية النادي</p><h1>اصنع تجربتك معنا</h1><p>أربع لجان، ومساحات متنوعة للتعلم والتطوع والقيادة.</p></div></div><div class="grid"><div class="card"><div class="card-body"><h2>لجنة الأنشطة</h2><p>تصميم وتنفيذ الفعاليات والورش.</p></div></div><div class="card"><div class="card-body"><h2>لجنة الإعلام</h2><p>التغطيات والهوية والمحتوى المرئي.</p></div></div><div class="card"><div class="card-body"><h2>لجنة المحتوى والتطوير</h2><p>المحتوى المعرفي وتنمية مهارات الفريق.</p></div></div><div class="card"><div class="card-body"><h2>لجنة الموارد البشرية</h2><p>تجربة الأعضاء وتنظيم الفريق.</p></div></div></div>{cycles.map(cycle=><section class="section"><div class="section-heading"><div><h2>{String(cycle.title)}</h2><p>{String(cycle.description||'')}</p></div></div><DynamicForm kind="applications" target={cycle.id} fields={cycle.fields} siteKey={env.TURNSTILE_SITE_KEY}/></section>)}{!cycles.length&&<div class="empty" style="margin-top:32px"><h2>باب الانضمام مغلق حاليًا</h2><p>سنعلن عن دورة القبول القادمة عند فتحها.</p></div>}</div></section></BaseLayout>
