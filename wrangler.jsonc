{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ieee-imsiu",
  "main": "@astrojs/cloudflare/entrypoints/server",
  "compatibility_date": "2026-09-18",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "binding": "ASSETS",
    "directory": "./dist/client"
  },
  "observability": {
    "enabled": true,
    "traces": {
      "enabled": true
    }
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "ieee-imsiu",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "FILES",
      "bucket_name": "ieee-imsiu-files"
    }
  ],
  "vars": {
    "APP_ENV": "production",
    "ACCESS_TEAM_DOMAIN": "",
    "ACCESS_AUD": "",
    "INITIAL_ADMIN_EMAIL": "",
    "EMAIL_FROM": "",
    "TURNSTILE_SITE_KEY": "",
    "WEB_ANALYTICS_TOKEN": ""
  },
  "env": {
    "local": {
      "vars": {
        "APP_ENV": "development",
        "ACCESS_TEAM_DOMAIN": "",
        "ACCESS_AUD": "",
        "INITIAL_ADMIN_EMAIL": "admin@example.test",
        "EMAIL_FROM": "",
        "TURNSTILE_SITE_KEY": "",
        "WEB_ANALYTICS_TOKEN": ""
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "ieee-imsiu",
          "database_id": "00000000-0000-0000-0000-000000000000",
          "migrations_dir": "migrations"
        }
      ],
      "r2_buckets": [
        {
          "binding": "FILES",
          "bucket_name": "ieee-imsiu-files"
        }
      ]
    }
  }
}
